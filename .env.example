# Newsletter provider: "kit" (recommended, free up to 10,000 subscribers) or "buttondown"
NUXT_NEWSLETTER_PROVIDER=kit

# Kit (kit.com): Settings > Developer > API keys (v4 key), and the id of the form subscribers join
NUXT_KIT_API_KEY=
NUXT_KIT_FORM_ID=

# Buttondown (buttondown.com): Settings > API
NUXT_BUTTONDOWN_API_KEY=

# Topic suggestions are emailed through Resend (resend.com, free: 3,000 emails/month).
# Resend > API Keys > Create API key (Sending access is enough)
NUXT_RESEND_API_KEY=
# Where suggestions are delivered (comma-separate several addresses)
NUXT_SUGGEST_TO=
# Optional. Leave empty to use Resend's test sender, which only delivers to the
# address your Resend account was created with. Set it after verifying a domain.
NUXT_SUGGEST_FROM=

# Public site URL, used for RSS, sitemap and social cards
NUXT_PUBLIC_SITE_URL=https://sdlab.vercel.app
