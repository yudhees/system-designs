# Newsletter provider: "kit" (recommended, free up to 10,000 subscribers) or "buttondown"
NUXT_NEWSLETTER_PROVIDER=kit

# Kit (kit.com): Settings > Developer > API keys (v4 key), and the id of the form subscribers join
NUXT_KIT_API_KEY=
NUXT_KIT_FORM_ID=

# Buttondown (buttondown.com): Settings > API
NUXT_BUTTONDOWN_API_KEY=

# Public site URL, used for RSS, sitemap and social cards
NUXT_PUBLIC_SITE_URL=https://sdlab-yudhees-projects.vercel.app
